<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0F172A"
    android:padding="24dp">

    <!-- Tasklert Brand Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E293B"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ TASKLERT ALARM"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- Large Digital Clock -->
    <TextView
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:00 PM"
        android:textColor="#FFFFFF"
        android:textSize="54sp"
        android:fontFamily="sans-serif-thin"
        android:textStyle="bold" />

    <!-- Session Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯 Focus Session Complete!"
        android:textColor="#F8FAFC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:gravity="center" />

    <!-- Ringtone Name Badge -->
    <TextView
        android:id="@+id/tvRingtoneName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎵 Tere Vaaste.mp3"
        android:textColor="#94A3B8"
        android:textSize="15sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="48dp" />

    <!-- Snooze Duration Options -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Snooze for:"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnSnooze5"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="5 min"
            android:textColor="#FFFFFF"
            android:background="#334155"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSnooze10"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="10 min"
            android:textColor="#FFFFFF"
            android:background="#334155"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSnooze15"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="15 min"
            android:textColor="#FFFFFF"
            android:background="#334155" />
    </LinearLayout>

    <!-- Large Primary Dismiss Button -->
    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="✓ DISMISS ALARM"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#0284C7" />

</LinearLayout>

