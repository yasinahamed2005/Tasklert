<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <!-- Tasklert Royal Purple to Magenta Gradient -->
    <linearGradient id="tasklertBgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4c1d95" />
      <stop offset="35%" stop-color="#7e22ce" />
      <stop offset="75%" stop-color="#c026d3" />
      <stop offset="100%" stop-color="#e11d48" />
    </linearGradient>

    <!-- Subtle Premium Ring Highlight -->
    <linearGradient id="tasklertRingHighlight" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="rgba(255, 255, 255, 0.45)" />
      <stop offset="50%" stop-color="rgba(255, 255, 255, 0.12)" />
      <stop offset="100%" stop-color="rgba(255, 255, 255, 0.02)" />
    </linearGradient>

    <!-- T-Symbol Gradient -->
    <linearGradient id="tasklertTSymbol" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#f5d0fe" />
    </linearGradient>

    <!-- Bell Alert Gradient -->
    <linearGradient id="tasklertBellGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#fae8ff" />
    </linearGradient>

    <!-- Bell Soft Shadow -->
    <filter id="tasklertDropShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="2.5" flood-color="#3b0764" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- Circular Outer Container -->
  <circle cx="50" cy="50" r="46" fill="url(#tasklertBgGrad)" stroke="url(#tasklertRingHighlight)" stroke-width="1.5" />

  <!-- Stylized Modern Letter T -->
  <!-- Top Bar & Stem combined -->
  <path d="M 24 28 C 24 24.5, 27 23, 31 23 L 69 23 C 73 23, 76 24.5, 76 28 C 76 31.5, 73 33, 69 33 L 55.5 33 L 55.5 69 C 55.5 73, 51.5 76, 46.5 76 C 41.5 76, 37.5 73, 37.5 69 L 37.5 33 L 31 33 C 27 33, 24 31.5, 24 28 Z" fill="url(#tasklertTSymbol)" />

  <!-- T-Stem Subtle Glass Reflection -->
  <path d="M 37.5 33 L 37.5 69 C 37.5 73, 41.5 76, 46.5 76 C 51.5 76, 55.5 73, 55.5 69 L 55.5 33 Z" fill="#ffffff" fill-opacity="0.12" />

  <!-- Integrated Alert Bell & Sound Arcs -->
  <g filter="url(#tasklertDropShadow)">
    <!-- Bell Body -->
    <path d="M 64.5 45 C 64.5 43.5, 63 42, 60.5 42 C 58 42, 56.5 43.5, 56.5 45 C 56.5 46.2, 54.5 48.5, 53 53.5 C 52 57, 51.5 59.5, 51.5 60.5 C 51.5 61.5, 52.5 62, 54 62 L 67 62 C 68.5 62, 69.5 61.5, 69.5 60.5 C 69.5 59.5, 69 57, 68 53.5 C 66.5 48.5, 64.5 46.2, 64.5 45 Z" fill="url(#tasklertBellGrad)" />
    
    <!-- Bell Clapper -->
    <path d="M 58 63.2 C 58 65.2, 59.1 66.5, 60.5 66.5 C 61.9 66.5, 63 65.2, 63 63.2 Z" fill="#ffffff" />
    
    <!-- Sound Wave Arc 1 -->
    <path d="M 72.5 48.5 C 75.8 52, 75.8 57, 72.5 60.5" fill="none" stroke="#f472b6" stroke-width="2.5" stroke-linecap="round" />

    <!-- Sound Wave Arc 2 (Alert Pulse Dot) -->
    <circle cx="76.5" cy="46" r="2" fill="#fb7185" />
  </g>
</svg>
