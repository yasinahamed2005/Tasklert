# -------------------------------------------------------------
# Tasklert — Comprehensive Git Ignore Rules
# -------------------------------------------------------------

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment and Secret Files (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env

# Production Build Outputs
dist/
dist-ssr/
build/
*/dist/
*/build/

# Vercel & Deployment Caches
.vercel/
.turbo/
.vite/
*.tsbuildinfo

# Logs and Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# User Uploads & Transient Storage (preserve directory structure via .gitkeep)
backend/uploads/**
!backend/uploads/
!backend/uploads/**/
!backend/uploads/**/.gitkeep

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
